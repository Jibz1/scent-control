# The broker the desktop app starts with when nothing is saved, and the default for the
# Phase 0 tools (tools/broker.py, tools/control_server.py). Copy this file to .env at
# the repo root (it stays out of git) and put in your own broker. scripts/bundle-macos.sh
# compiles these three into the app; without them the app asks for a broker in Settings.
#
# The broker password never goes here. Save it in the app's Settings, which keeps it in
# the macOS Keychain. The build ignores any key with PASSWORD in its name.
SCENT_BROKER_URL=wss://your-broker.example/mqtt
SCENT_BROKER_USERNAME=your-username
SCENT_ROUTE_ID=your-route-id
