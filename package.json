{
  "name": "@scent-control/monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "tools"
    ],
    "catalog": {
      "effect": "4.0.2"
    }
  },
  "scripts": {
    "build": "turbo run build",
